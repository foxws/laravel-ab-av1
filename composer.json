{
    "name": "foxws/laravel-ab-av1",
    "description": "A Laravel package for encoding videos to AV1 format using ab-av1.",
    "keywords": [
        "foxws",
        "laravel",
        "ab-av1",
        "av1",
        "video",
        "encoding",
        "ffmpeg"
    ],
    "homepage": "https://github.com/foxws/laravel-ab-av1",
    "license": "MIT",
    "authors": [
        {
            "name": "francoism90",
            "email": "francoism90@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/filesystem": "^12.0||^13.0",
        "illuminate/process": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "psr/log": "^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Foxws\\AbAv1\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Foxws\\AbAv1\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foxws\\AbAv1\\AbAv1ServiceProvider"
            ],
            "aliases": {
                "AbAv1": "Foxws\\AbAv1\\Facades\\AbAv1"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
